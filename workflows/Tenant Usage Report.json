{
  "name": "Tenant Usage Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -384,
        0
      ],
      "id": "aaa68ceb-3794-4c02-8eab-e6afaaed5e93",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.tenant_id, t.name, t.plan, \n       COUNT(u.id) as total_runs,\n       MAX(u.run_at) as last_run\nFROM tenants t\nLEFT JOIN tenant_usage u ON t.tenant_id = u.tenant_id\nWHERE t.active = true\nGROUP BY t.tenant_id, t.name, t.plan;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -176,
        0
      ],
      "id": "9277e3be-4ba6-4f2d-b93a-25017efd611b",
      "name": "Fetch All Tenants",
      "credentials": {
        "postgres": {
          "id": "smlZ1yiJKbBntooj",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#support-urgent",
          "mode": "name"
        },
        "text": "=📊 Daily Tenant Usage Report {{ $json.name }} ({{ $json.plan }}) Total runs: {{ $json.total_runs }} Last run: {{ $json.last_run ?? 'Never' }}",
        "otherOptions": {}
      },
