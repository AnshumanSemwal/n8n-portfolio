      "name": "Fetch RSS Feed"
    },
    {
      "parameters": {
        "jsCode": "const xml = $input.first().json.data;\n\n// Extract first entry (latest video)\nconst titleMatch = xml.match(/<entry>[\\s\\S]*?<title>(.*?)<\\/title>/);\nconst linkMatch = xml.match(/<entry>[\\s\\S]*?<link[^>]*href=\"([^\"]*)\"[^>]*\\/>/);\nconst publishedMatch = xml.match(/<entry>[\\s\\S]*?<published>(.*?)<\\/published>/);\nconst authorMatch = xml.match(/<author>[\\s\\S]*?<name>(.*?)<\\/name>/);\n\nconst title = titleMatch ? titleMatch[1] : 'Unknown Title';\nconst url = linkMatch ? linkMatch[1] : '';\nconst published = publishedMatch ? publishedMatch[1] : '';\nconst author = authorMatch ? authorMatch[1] : 'Unknown';\n\nreturn [{\n  json: {\n    title,\n    url,\n    published,\n    author,\n    channel: 'Andrej Karpathy'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        -48
      ],
      "id": "898a0b36-738b-492c-ad80-fe8254675022",
      "name": "Parse Latest Video"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Video title: {{ $json.title }}\nChannel: {{ $json.channel }}\nURL: {{ $json.url }}\nPublished: {{ $json.published }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a social media content writer specializing in AI content.  Write an engaging Twitter/X thread (3 tweets) about the YouTube video described.  Be informative, use relevant hashtags, and end with the video URL. Keep each tweet under 280 characters. Format as: Tweet 1: [content] Tweet 2: [content]   Tweet 3: [content]"
            }
          ]
        },
        "batching": {}
      },
