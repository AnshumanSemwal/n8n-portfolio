    {
      "parameters": {
        "jsCode": "const xml = $input.first().json.data;\n\nif (typeof xml !== 'string') {\n  throw new Error('Expected the RSS body as a string on `data`. Check that Fetch RSS Feed has responseFormat = text.');\n}\n\n// Isolate the first <entry> so feed-level <title>/<link> can never leak in.\nconst entryMatch = xml.match(/<entry>([\\s\\S]*?)<\\/entry>/);\nif (!entryMatch) {\n  throw new Error('No <entry> found in the feed.');\n}\nconst entry = entryMatch[1];\n\nconst decode = (s) =>\n  String(s ?? '')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&apos;/g, \"'\")\n    .replace(/&#(\\d+);/g, (_, d) => String.fromCharCode(Number(d)))\n    .replace(/&amp;/g, '&')\n    .trim();\n\nconst titleMatch = entry.match(/<title>([\\s\\S]*?)<\\/title>/);\nconst linkMatch = entry.match(/<link[^>]*href=\"([^\"]*)\"/);\nconst publishedMatch = entry.match(/<published>(.*?)<\\/published>/);\nconst videoIdMatch = entry.match(/<yt:videoId>(.*?)<\\/yt:videoId>/);\nconst authorMatch = entry.match(/<author>[\\s\\S]*?<name>([\\s\\S]*?)<\\/name>/)\n  || xml.match(/<author>[\\s\\S]*?<name>([\\s\\S]*?)<\\/name>/);\n\nreturn [{\n  json: {\n    title: titleMatch ? decode(titleMatch[1]) : 'Unknown Title',\n    url: linkMatch ? decode(linkMatch[1]) : '',\n    video_id: videoIdMatch ? videoIdMatch[1] : '',\n    published: publishedMatch ? publishedMatch[1].trim() : '',\n    author: authorMatch ? decode(authorMatch[1]) : 'Unknown',\n    channel: 'Andrej Karpathy'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1632,
        240
      ],
