    {
      "parameters": {
        "jsCode": "// Carry the whole payload forward and bump the counter that lives in the\n// item data. `Check Approval`'s output only contains { data: {...} } from the\n// Telegram wait node, so the state is pulled from the merge node by name.\nconst state = $('Code in JavaScript').first().json;\n\nreturn [{\n  json: {\n    ...state,\n    revision_count: (state.revision_count ?? 0) + 1\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        256
      ],
      "id": "9ab6a864-1dea-4806-ba8e-3c7b4c45ceb7",
      "name": "Increment Counter"
    },
    {
      "parameters": {
        "jsCode": "const video = $('Parse Latest Video').first().json;\nconst draft = $input.first().json; // chainLlm outputs only { text }\n\n// chainLlm does NOT pass input fields through, so the loop state has to be\n// read from whichever node fed it: Add Feedback on revisions, Initialize\n// Counter on the first pass. Referencing an unexecuted node throws.\nlet state;\ntry {\n  state = $('Add Feedback').first().json;\n} catch (e) {\n  state = $('Initialize Counter').first().json;\n}\n\nconst text = draft.text ?? '';\n\nconst grabTweet = (n) => {\n  const re = new RegExp(\n    `Tweet\\\\s*${n}\\\\s*[:\\\\-\\\\)]?\\\\s*(.*?)(?=\\\\s*\\\\**\\\\s*Tweet\\\\s*${n + 1}\\\\s*[:\\\\-\\\\)]|$)`,\n    'is'\n  );\n  const m = text.match(re);\n  return m ? m[1].replace(/\\*\\*/g, '').trim() : '';\n};\n\nreturn [{\n  json: {\n    title: video.title,\n    url: video.url,\n    channel: video.channel,\n    published: video.published,\n    revision_count: state.revision_count ?? 0,\n    feedback: state.feedback ?? '',\n    text,\n    tweet1: grabTweet(1),\n    tweet2: grabTweet(2),\n    tweet3: grabTweet(3)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
